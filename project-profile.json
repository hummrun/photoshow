{
  "version": 2,
  "project": {
    "name": "photoshow",
    "type": ["desktop", "desktop-gui"]
  },
  "stack": {
    "languages": ["rust"],
    "runtime": ["eframe", "egui"],
    "tooling": ["cargo", "rustfmt", "clippy"]
  },
  "features": [
    "photo-viewer",
    "filesystem-navigation",
    "thumbnail-gallery",
    "zoom-pan",
    "non-destructive-editing",
    "metadata",
    "desktop-ui",
    "packaging"
  ],
  "quality": {
    "performance": "high",
    "accessibility": true,
    "security": "standard"
  },
  "risk": [
    "filesystem-write",
    "performance-critical",
    "large-media-memory"
  ],
  "ai": {
    "orchestrator": "native",
    "autonomy": "controlled",
    "preferred_models": [
      {
        "id": "openai/gpt-5.6-sol",
        "provider": "openai",
        "notes": "Architecture, review, complex Rust changes and release-critical work."
      },
      {
        "id": "moonshot/kimi-k3",
        "provider": "moonshot",
        "notes": "Implementation support and broad repository analysis."
      },
      {
        "id": "deepseek/v4.1-flash",
        "provider": "deepseek",
        "notes": "Fast implementation and routine refactors with verification gates."
      }
    ]
  }
}
