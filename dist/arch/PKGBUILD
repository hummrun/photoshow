# Maintainer: Raillen <raillen@users.noreply.github.com>
pkgname=photoshow
pkgver=0.1.0rc1
pkgrel=1
pkgdesc="Fast photo viewer with light non-destructive editing"
arch=('x86_64')
url="https://github.com/raillen/photoshow"
license=('MIT')
depends=('gcc-libs' 'glibc' 'mesa')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/raillen/photoshow/archive/refs/tags/v0.1.0-rc1.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-0.1.0-rc1"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-0.1.0-rc1"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_NET_OFFLINE=true
  cargo build --release --frozen
}

package() {
  cd "$pkgname-0.1.0-rc1"
  install -Dm755 target/release/photoshow "$pkgdir/usr/bin/photoshow"
  install -Dm644 dist/photoshow.desktop "$pkgdir/usr/share/applications/photoshow.desktop"
  install -Dm644 assets/icons/photoshow.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/photoshow.svg"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
